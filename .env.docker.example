# ============================================================
# Docker 环境变量示例
# 复制此文件并填入你的密钥：cp .env.docker.example .env.docker
# 然后在 docker-compose 中使用：docker compose --env-file .env.docker up
# ============================================================

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key

# Supabase 配置（用于认证和存储）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
